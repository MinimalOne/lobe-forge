#!/bin/sh
# Generated by lobe-forge for the {{NAME}} lobe. Runs wiki_tool.py against this lobe's wiki.
#   wikictl paths   -> prints LOBE=, REPO=, WIKI=, RAW= for: eval "$(wikictl paths)"
#   wikictl <cmd>   -> wiki_tool.py <cmd> (search, links, sections, index-add, set-atoms, pending, lint, build, convert-legacy)
here=$(cd -P "$(dirname "$0")" && pwd)
repo=$(cd -P "$here/{{REPO_LINK}}" 2>/dev/null && pwd) || { echo "wikictl: repo link $here/{{REPO_LINK}} is broken" >&2; exit 1; }
if [ "$1" = paths ]; then
  printf "LOBE='%s'\nREPO='%s'\nWIKI='%s'\nRAW='%s'\n" "$here" "$repo" "$repo/{{WIKI}}" "$repo/{{RAW}}"
  exit 0
fi
WIKI_ROOT="$repo" WIKI_DIR="{{WIKI}}" WIKI_RAW_DIR="{{RAW}}" WIKI_CATALOG="$here/catalog.jsonl" \
  exec python3 "$here/wiki_tool.py" "$@"
